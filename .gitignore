build/*
!build/toolchains/
build/toolchains/*
!build/toolchains/vs2003/
!build/toolchains/vs2003/**

# The vs2003 un-ignore above is deliberately wide, which leaves the two
# Microsoft SDKs staged back into the toolchain by tools/toolchain restore
# one `git add build/` away from being committed. They are proprietary and
# redistributable to nobody: PlatformSDK is the XP SP2 (Aug 2004) Platform
# SDK, atlmfc is the VS2003 ATL/MFC component. Both must stay local.
build/toolchains/vs2003/**/Vc7/PlatformSDK/
build/toolchains/vs2003/**/Vc7/atlmfc/

.venv/
__pycache__/
*.pyc
reverse/exports.csv
reverse/ghidra_functions.csv
reverse/string_xrefs.tsv
reverse/.add_match.lock
reverse/zh_sweep/locate_state.json

# Alternate-case sweep shims: only the canonical spelling of each dual-case
# include is committed (a case-only-colliding path breaks Windows/macOS checkout).
# tools/gen_case_shims.py regenerates these at build time on case-sensitive FSes.
reference/shims/sweep/mss.h
reference/shims/sweep/wsys/file.h
reference/shims/sweep/stdAfx.h
reference/shims/sweep/WorldBuilder.h
reference/shims/sweep/wpaudio/Source.h
reference/shims/sweep/D3DX8Math.h
